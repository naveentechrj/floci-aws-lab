# Copy to terraform.tfvars and edit. Values shown are the lab defaults.
region              = "us-east-1"
floci_endpoint      = "http://localhost:4566"
project             = "floci-lab"

vpc_cidr            = "10.0.0.0/16"
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidr = "10.0.3.0/24"

# Use the ID that `aws ec2 describe-images` returns from Floci.
ami_id              = "ami-0c55b159cbfafe1f0"
instance_type       = "t2.micro"

ssh_public_key_path = "~/.ssh/floci-lab.pub"
admin_cidrs         = ["192.168.56.0/24", "172.17.0.0/16"]

alert_forwarder_url = "http://172.17.0.1:5005/sns"
